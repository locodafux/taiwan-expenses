# Copy to .env.local and fill in. Metro inlines EXPO_PUBLIC_* vars at build
# time (see src/lib/supabase.ts) - no extra config-loading dependency needed.
#
# Local dev (supabase start): run `supabase status` after starting the CLI
# stack and use its printed "API URL" / "anon key".
# Real project (once the captain creates one): Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
